{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered university student or administrator profile synced with Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "specializationId": { "type": "string", "maxLength": 128 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Trusted administrator lookup entry keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "addedAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "addedAt"]
    },
    "Specialization": {
      "title": "Specialization",
      "description": "University academic specialization managed dynamically by administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 600 },
        "iconKey": { "type": "string", "minLength": 1, "maxLength": 60 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "sortOrder": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "iconKey", "status", "sortOrder", "createdAt", "updatedAt"]
    },
    "AcademicYear": {
      "title": "AcademicYear",
      "description": "Academic year belonging to a specific specialization.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "specializationId", "name", "status", "sortOrder", "createdAt", "updatedAt"]
    },
    "Semester": {
      "title": "Semester",
      "description": "Academic semester belonging to a specific specialization and academic year.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "specializationId", "academicYearId", "name", "status", "sortOrder", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic course/subject inside a specific semester.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "semesterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "description": { "type": "string", "maxLength": 500 },
        "iconKey": { "type": "string", "minLength": 1, "maxLength": 60 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "specializationId", "academicYearId", "semesterId", "name", "iconKey", "status", "sortOrder", "createdAt", "updatedAt"]
    },
    "LectureFile": {
      "title": "LectureFile",
      "description": "Uploaded educational lecture file linked to an exact specialization, year, semester, and subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "semesterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 800 },
        "category": {
          "type": "string",
          "enum": [
            "lectures_pdf",
            "powerpoint",
            "word",
            "notes",
            "summaries",
            "books",
            "assignments",
            "past_exams",
            "extra"
          ]
        },
        "lectureNumber": { "type": "string", "maxLength": 40 },
        "version": { "type": "string", "maxLength": 40 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "originalName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "fileExt": { "type": "string", "minLength": 1, "maxLength": 20 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "storageName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "allowDownload": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "sortOrder": { "type": "number" },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "specializationId",
        "academicYearId",
        "semesterId",
        "subjectId",
        "title",
        "category",
        "fileName",
        "originalName",
        "fileExt",
        "mimeType",
        "fileSize",
        "storageName",
        "allowDownload",
        "status",
        "sortOrder",
        "uploadedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "University academic announcement or exam schedule notice.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "body": { "type": "string", "minLength": 2, "maxLength": 2000 },
        "category": { "type": "string", "enum": ["general", "exams", "lectures", "academic"] },
        "priority": { "type": "string", "enum": ["normal", "important"] },
        "specializationId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "body", "category", "priority", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Notification emitted when new lecture files or announcements are published.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "message": { "type": "string", "minLength": 2, "maxLength": 600 },
        "type": { "type": "string", "enum": ["lecture", "announcement", "system"] },
        "specializationId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "fileId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "message", "type", "status", "createdAt"]
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "Student bookmark referencing a lecture file.",
      "type": "object",
      "properties": {
        "fileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileId", "subjectId", "createdAt"]
    },
    "UserReadNotification": {
      "title": "UserReadNotification",
      "description": "Tracks per-user read status for a notification without unbounded arrays.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "readAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "readAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Administrative audit trail entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 254 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "actorEmail", "action", "entityType", "entityId", "entityName", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Configurable upload limits and platform settings managed by admins.",
      "type": "object",
      "properties": {
        "maxFileSizeMB": { "type": "number" },
        "allowZipUploads": { "type": "boolean" },
        "platformTitle": { "type": "string", "minLength": 2, "maxLength": 120 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maxFileSizeMB", "allowZipUploads", "platformTitle", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile documents isolated to owner or admin."
    },
    "/users/{userId}/favorites/{fileId}": {
      "schema": { "$ref": "#/entities/UserFavorite" },
      "description": "Student saved favorite lecture files."
    },
    "/users/{userId}/readNotifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserReadNotification" },
      "description": "Student notification read receipts."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Trusted administrator UIDs for role verification."
    },
    "/specializations/{specializationId}": {
      "schema": { "$ref": "#/entities/Specialization" },
      "description": "University academic specializations."
    },
    "/academicYears/{yearId}": {
      "schema": { "$ref": "#/entities/AcademicYear" },
      "description": "Academic years linked to specializations."
    },
    "/semesters/{semesterId}": {
      "schema": { "$ref": "#/entities/Semester" },
      "description": "Semesters linked to academic years."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "Academic subjects linked to semesters."
    },
    "/lectureFiles/{fileId}": {
      "schema": { "$ref": "#/entities/LectureFile" },
      "description": "Lecture files metadata linked to subjects."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "University announcements."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Platform notifications."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Admin activity logs."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Platform configuration settings."
    }
  }
}
