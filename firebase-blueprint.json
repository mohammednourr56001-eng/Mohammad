    "LectureFile": {
      "title": "LectureFile",
      "description": "Uploaded educational lecture file linked to an exact specialization, year, semester, and subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYearId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "semesterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 800 },
        "category": {
          "type": "string",
          "enum": [
            "lectures_pdf",
            "powerpoint",
            "word",
            "notes",
            "summaries",
            "books",
            "assignments",
            "past_exams",
            "extra"
          ]
        },
        "lectureNumber": { "type": "string", "maxLength": 40 },
        "version": { "type": "string", "maxLength": 40 },
        "sourceType": { "type": "string", "enum": ["upload", "google_drive"] },
        "externalUrl": { "type": "string", "maxLength": 1000, "pattern": "^https://(drive|docs)\\.google\\.com/.+$" },
        "driveFileId": { "type": "string", "maxLength": 180, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "originalName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "fileExt": { "type": "string", "minLength": 1, "maxLength": 20 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "fileSize": { "type": "number" },
        "storageName": { "type": "string", "minLength": 1, "maxLength": 260 },
        "storagePath": { "type": "string", "maxLength": 400 },
        "sha256": { "type": "string", "maxLength": 128 },
        "allowDownload": { "type": "boolean" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "lifecycleStatus": { "type": "string", "enum": ["active", "trashed", "needs_review"] },
        "deletedAt": { "type": "string", "maxLength": 64 },
        "deletedBy": { "type": "string", "maxLength": 128 },
        "sortOrder": { "type": "number" },
        "uploadedBy": { "type": "string", "maxLength": 128 },
        "uploadedByEmail": { "type": "string", "maxLength": 254 },
        "uploadedByName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "specializationId",
        "academicYearId",
        "semesterId",
        "subjectId",
        "title",
        "category",
        "fileName",
        "originalName",
        "fileExt",
        "mimeType",
        "fileSize",
        "storageName",
        "allowDownload",
        "status",
        "sortOrder",
        "uploadedBy",
        "createdAt",
        "updatedAt"
      ]
    },
