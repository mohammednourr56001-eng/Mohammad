      "required": ["id", "uid", "email", "displayName", "role", "specializationId", "status", "permissions", "scopeVersion", "assignedBy", "assignedByEmail", "assignedAt", "updatedAt"]
    },
    "AdminPermissionRecord": {
      "title": "AdminPermissionRecord",
      "description": "Normalized per-permission row for specialization-scoped administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-.]+$" },
        "assignmentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "specializationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "permissionKey": { "type": "string", "minLength": 3, "maxLength": 80 },
        "granted": { "type": "boolean" },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "assignmentId", "uid", "specializationId", "permissionKey", "granted", "grantedBy", "createdAt", "updatedAt"]
    },
    "AdminInvitation": {
      "title": "AdminInvitation",
      "description": "Pending or accepted staff role invitation bound to a verified Google email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
