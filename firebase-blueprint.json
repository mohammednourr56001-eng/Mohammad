{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered university student, moderator, administrator, or Super Admin profile synced with Google OAuth / Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "googleSub": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["student", "moderator", "admin", "super_admin"] },
        "permissions": { "type": "array", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "specializationId": { "type": "string", "maxLength": 128 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "assignedSpecializationId": { "type": "string", "maxLength": 128 },
        "assignmentId": { "type": "string", "maxLength": 128 },
        "scopeVersion": { "type": "number" },
        "lastActivityAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Trusted staff/admin permission entry keyed by Firebase Auth UID with optional specialization scope.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "moderator"] },
        "permissions": { "type": "array", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
