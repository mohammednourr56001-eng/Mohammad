        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "role", "permissions", "status", "addedAt"]
    },
    "AdminAssignment": {
      "title": "AdminAssignment",
      "description": "Explicit specialization-scoped admin assignment record created and managed by Super Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
